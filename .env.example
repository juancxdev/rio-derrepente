POSTGRES_USER=tourism
POSTGRES_PASSWORD=tourism
POSTGRES_DB=tourism
DATABASE_URL=postgres://tourism:tourism@postgres:5432/tourism?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Puertos publicados en el host. API_PORT es el puerto interno de la API.
FRONTEND_HOST_PORT=12000
API_HOST_PORT=12001
ML_HOST_PORT=12002
RABBITMQ_MANAGEMENT_HOST_PORT=12003
API_PORT=8080
SITE_ID=11111111-1111-1111-1111-111111111111
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
SITE_LATITUDE=-9.295000
SITE_LONGITUDE=-75.996000
WORKER_ONCE=false
CLOSURE_HOUR=18

# Entorno: use production en un despliegue real. Con production la API exige
# AUTH_JWT_SECRET y no arranca con la clave de desarrollo.
APP_ENV=development
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL=8h

# Seed opcional de una cuenta demo de tenant. No hay contraseña por defecto:
# si APP_SEED_DEMO=true, DEMO_USER_PASSWORD es obligatorio.
APP_SEED_DEMO=false
DEMO_TENANT_ID=00000000-0000-0000-0000-000000000001
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_USER_NAME=Operador de demostración
DEMO_USER_ROLE=manager

# El super administrador no se crea por variables de entorno ni tiene
# contraseña por defecto. Para crear una migración versionada con bcrypt:
# cd backend
# go run ./cmd/generate-superadmin-migration --email admin@example.com
# Luego revisa los archivos 00N_seed_super_admin.{up,down}.sql, haz commit
# y ejecuta la migración con:
# docker compose --profile tools run --rm migrate
# Cada cambio posterior de credenciales debe generar una nueva migración.

# Rutas legacy de visitas: solo compatibilidad, la UI principal no las usa.
APP_ENABLE_LEGACY_ROUTES=false
