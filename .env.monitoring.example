# Copia este archivo a .env.monitoring y define un secreto propio, o ejecuta
# ./scripts/monitoring-up.sh para generar la contraseña automáticamente.
# No uses contraseñas por defecto ni subas .env.monitoring al repositorio.

GRAFANA_ADMIN_PASSWORD=

# Red Docker del stack principal. Si usas otro nombre de proyecto, cámbiala.
APP_NETWORK=proyecto-aplicaciones-para-la-nube_default

# Puertos locales publicados por el stack de monitoreo.
MONITORING_BIND_ADDRESS=127.0.0.1
MONITORING_GRAFANA_PORT=13000
MONITORING_PROMETHEUS_PORT=13090
MONITORING_ALLOY_PORT=13001

# Destino por defecto de las pruebas de salud cuando k6 corre en Docker.
K6_BASE_URL=http://frontend
K6_TARGET_PATH=/health

# Base de la API para las pruebas de carga y estrés. Dentro de Docker se
# resuelve por el nombre del servicio; desde el host usa http://127.0.0.1:12001.
K6_API_BASE_URL=http://api:8080
